# Tartale — environment. Copy to .env.local for development.
# On Vercel, set these in Project → Settings → Environment Variables
# (mark the secrets as "Sensitive"). Never commit real values.

# --- Required ---------------------------------------------------------------

# Supabase → Project Settings → Database → Connection string → Transaction
# pooler (port 6543). URL-encode the password if it contains @ : / # ?
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# 32+ random characters each, all different:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
IP_HASH_SECRET=""

# Vercel sends it to the two daily crons (retention sweep, birthdays).
# Unset: the cron endpoints answer 404 and nothing is swept.
CRON_SECRET=""

# --- Payments (Stripe) ------------------------------------------------------

# Unset: the order form says payments are not switched on and refuses orders.
# Test mode first (sk_test_…), live (sk_live_… or a restricted rk_live_…) at launch.
STRIPE_SECRET_KEY=""
# Stripe → Developers → Webhooks → endpoint https://<domain>/api/stripe/webhook
# with events checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, charge.refunded
STRIPE_WEBHOOK_SECRET=""

# --- Optional ---------------------------------------------------------------

# Defaults to https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel. Scheme and host
# only, no trailing slash. Every POST is refused unless its Origin matches.
# APP_ORIGIN="https://tartale.vercel.app"

# Only behind a proxy you control. On Vercel leave it unset.
# TRUST_PROXY_HEADERS=0

# First owner account, created once while the database has no accounts.
# BOOTSTRAP_ADMIN_FORCE=1 makes this email an active owner with this password
# even if accounts exist (recovery). Remove all four once you are in.
# BOOTSTRAP_ADMIN_EMAIL=""
# BOOTSTRAP_ADMIN_NAME=""
# BOOTSTRAP_ADMIN_PASSWORD=""
# BOOTSTRAP_ADMIN_FORCE=0

# One-time setup of an empty database (POST /api/setup with this as a bearer
# token applies supabase/schema.sql and supabase/seed.sql). Remove it after.
# SETUP_SECRET=""
