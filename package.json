    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.18.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
